# JourneyX environment
# Copy to .env.local and fill in the values from Supabase Studio →
# Project Settings → API. Never commit .env.local.

# --- Frontend --------------------------------------------------------------
# Base URL used by the client-side API fetcher (search dropdown, notification
# bell). Defaults to same-origin "/api/v1" when unset.
NEXT_PUBLIC_API_BASE_URL=

# --- Supabase (server-side reads) ------------------------------------------
# Project URL, e.g. https://xmbfocscluhndxyodrwa.supabase.co
SUPABASE_URL=
# Anon / publishable key (safe for server components; RLS still applies).
SUPABASE_ANON_KEY=

# Mirror the URL + anon key for any browser-side Supabase usage. Never mirror
# the service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only, DO NOT expose to the browser) ------------------
# Service role key. Used by scripts/seed.ts and by the server-side query and
# ingestion layer. Read only from "server-only" modules; never bundled.
SUPABASE_SERVICE_ROLE_KEY=

# --- Backend runtime -------------------------------------------------------
# Fix "now" for deterministic demos. ISO-8601, e.g. 2026-09-22T12:00:00Z.
# Detectors and analytics are pure functions of (events, asOf), so pinning this
# keeps every window, silence counter and churn rule stable on demo day.
DEMO_AS_OF=

# Required on a deployment: ingestion (POST /events, /events/batch) needs a
# matching x-ingest-token header. A production build with this unset rejects
# all ingestion. Leave unset locally so `npm run dev` and the demo replay can
# write freely. Every other /api/v1 route needs a signed-in session, except
# /api/v1/health.
# INGEST_TOKEN=

# Base URL used by `npm run replay`. Defaults to http://localhost:3000.
# REPLAY_BASE_URL=
