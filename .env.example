# JourneyX environment
# Copy to .env.local and fill in the values from Supabase Studio →
# Project Settings → API. Never commit .env.local.

# --- Frontend --------------------------------------------------------------
# Base URL used by the client-side API fetcher (search dropdown, notification
# bell). Defaults to same-origin "/api/v1" when unset.
NEXT_PUBLIC_API_BASE_URL=

# --- Supabase (server-side reads) ------------------------------------------
# Project URL, e.g. https://xmbfocscluhndxyodrwa.supabase.co
SUPABASE_URL=
# Anon / publishable key (safe for server components; RLS still applies).
SUPABASE_ANON_KEY=

# Mirror the URL + anon key for any browser-side Supabase usage. Never mirror
# the service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only, DO NOT expose to the browser) ------------------
# Service role key — used by scripts/seed.ts only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Backend runtime -------------------------------------------------------
# Fix "now" for deterministic demos. ISO-8601, e.g. 2026-09-19T12:00:00Z.
DEMO_AS_OF=
# Optional ingest token for a later milestone.
# INGEST_TOKEN=
